{
  "name": "@sreelal727/mcpwatch",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "See what your MCP servers cost you in tokens — and cut it. Records every MCP tool call, itemises the per-session tax each server charges, and tells your coding agent what to remove. All local, zero config.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sreelal727/mcpwatch.git"
  },
  "homepage": "https://github.com/Sreelal727/mcpwatch#readme",
  "bugs": {
    "url": "https://github.com/Sreelal727/mcpwatch/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcpwatch": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "ui-dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "token-usage",
    "cost-optimization",
    "context-window",
    "llm-cost",
    "ai-agents",
    "agent-tools",
    "observability",
    "proxy",
    "debugging",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "vibe-coding"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node -e \"const fs=require('fs');fs.copyFileSync('../../README.md','README.md');fs.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "zod": "^3.25.0"
  }
}
